{
  "name": "open-boost/open-boost-ui",
  "version": "1.0.0",
  "description": "Laravel Blade components + JS integration for Dropdown, Modals, Select2, Flatpickr, Charts, Editors etc. A powerful Bootstrap-ready UI component library.",
  "type": "composer-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Sandip Mandal",
      "email": "mrsandipmandal@gmail.com",
      "homepage": "https://github.com/mrsandipmandal"
    }
  ],
  "homepage": "https://github.com/mrsandipmandal/open-boost-ui",
  "keywords": ["laravel", "blade", "components", "bootstrap", "ui", "dropdown", "modal", "select2", "flatpickr", "chart", "editor"],
  "autoload": {
    "psr-4": {
      "OpenBoost\\UI\\": "src/",
      "OpenBoost\\Composer\\": "src/Composer/"
    }
  },
  "require": {
    "php": ">=8.0",
    "illuminate/support": "^9.0",
    "composer-plugin-api": "^2.0"
  },
  "require-dev": {},
  "scripts": {
    "post-install-cmd": [
      "@php artisan vendor:publish --provider=OpenBoost\\UI\\OpenBoostServiceProvider --tag=open-boost-ui --force"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --provider=OpenBoost\\UI\\OpenBoostServiceProvider --tag=open-boost-ui --force"
    ]
  },
  "extra": {
    "class": "OpenBoost\\Composer\\Plugin",
    "open-boost": {
      "resource_packages": [
        "npm-asset/jquery",
        "npm-asset/select2",
        "npm-asset/choices.js",
        "npm-asset/flatpickr",
        "npm-asset/chart.js",
        "npm-asset/apexcharts",
        "npm-asset/quill",
        "npm-asset/simplemde",
        "npm-asset/trix",
        "npm-asset/datatables.net"
      ],
      "resource_cdn": {
        "jquery": [
          "https://code.jquery.com/jquery-3.6.0.min.js"
        ],
        "select2": [
          "https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js",
          "https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css"
        ],
        "choices.js": [
          "https://cdn.jsdelivr.net/npm/choices.js@11.0.1/public/assets/scripts/choices.min.js",
          "https://cdn.jsdelivr.net/npm/choices.js@11.0.1/public/assets/styles/choices.min.css"
        ],
        "flatpickr": [
          "https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js",
          "https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css"
        ],
        "chart.js": [
          "https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"
        ],
        "apexcharts": [
          "https://cdn.jsdelivr.net/npm/apexcharts@5.0.0/dist/apexcharts.min.js"
        ],
        "quill": [
          "https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js",
          "https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css"
        ],
        "simplemde": [
          "https://cdn.jsdelivr.net/npm/simplemde@1.11.2/dist/simplemde.min.js",
          "https://cdn.jsdelivr.net/npm/simplemde@1.11.2/dist/simplemde.min.css"
        ],
        "trix": [
          "https://cdn.jsdelivr.net/npm/trix@2.1.15/dist/trix.min.js",
          "https://cdn.jsdelivr.net/npm/trix@2.1.15/dist/trix.css"
        ],
        "datatables.net": [
          "https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js",
          "https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css"
        ]
      }
    },
    "laravel": {
      "providers": [
        "OpenBoost\\UI\\OpenBoostServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": {
    "open-boost": {
      "type": "path",
      "url": "../open-boost-ui"
    }
  }
}
