{
  "name": "open-boost/open-boost-ui",
  "description": "Laravel Blade components + JS integration for Dropdown, Modals, Select2, Flatpickr, Charts, Editors etc. A powerful Bootstrap-ready UI component library.",
  "type": "composer-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Sandip Mandal",
      "email": "mrsandipmandal@gmail.com",
      "homepage": "https://mrsandipmandal.github.io"
    }
  ],
  "homepage": "https://github.com/mrsandipmandal/open-boost-ui",
  "keywords": ["laravel", "blade", "components", "bootstrap", "ui", "dropdown", "modal", "select2", "flatpickr", "chart", "editor"],
  "autoload": {
    "psr-4": {
      "OpenBoost\\UI\\": "src/",
      "OpenBoost\\Composer\\": "src/Composer/"
    }
  },
  "require": {
    "php": ">=8.0",
    "illuminate/support": "^9.0",
    "composer-plugin-api": "^2.0"
  },
  "require-dev": {},
  "scripts": {
    "post-install-cmd": [
      "@php artisan vendor:publish --provider=OpenBoost\\UI\\OpenBoostServiceProvider --tag=open-boost-ui --force"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --provider=OpenBoost\\UI\\OpenBoostServiceProvider --tag=open-boost-ui --force"
    ]
  },
  "extra": {
    "class": "OpenBoost\\Composer\\Plugin",
    "open-boost": {
      "resource_packages": [
        "npm-asset/jquery",
        "npm-asset/select2",
        "npm-asset/choices.js",
        "npm-asset/flatpickr",
        "npm-asset/chart.js",
        "npm-asset/apexcharts",
        "npm-asset/quill",
        "npm-asset/simplemde",
        "npm-asset/trix",
        "npm-asset/datatables.net"
      ]
    },
    "laravel": {
      "providers": [
        "OpenBoost\\UI\\OpenBoostServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": {
    "open-boost": {
      "type": "path",
      "url": "../open-boost-ui"
    }
  }
}
